<view class="studentlist-container">

  <!-- 搜索栏 -->
  <view class="search-bar">
    <input
      class="search-input"
      value="{{searchKeyword}}"
      placeholder="搜索学生姓名..."
      bindinput="onSearchInput"
      confirm-type="search"
      bindconfirm="onSearch"
    />
    <view class="search-btn" bindtap="onSearch">搜索</view>
  </view>

  <!-- 学生列表 -->
  <view class="student-list">
    <view
      class="student-card"
      wx:for="{{students}}"
      wx:key="id"
      bindtap="onStudentTap"
      data-id="{{item.id}}"
      data-name="{{item.nickname || item.name}}"
      data-avatar="{{item.avatar || ''}}"
    >
      <image class="student-avatar" src="{{item.avatar || 'https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100'}}" mode="aspectFill"></image>

      <view class="student-info">
        <view class="student-name">{{item.realName || item.nickname || item.name}}</view>
        <view class="student-meta" wx:if="{{item.lastRating}}">
          最近测评结果：
          <text class="{{item.lastRating === '重度抑郁' || item.lastRating === '阳性' ? 'danger' : 'safe'}}">
            {{item.lastRating}}
          </text>
          <text wx:if="{{item.lastTestDate}}">（{{item.lastTestDate}}）</text>
        </view>
        <view class="student-meta no-data" wx:if="{{!item.lastRating}}">
          暂无测评记录
        </view>
      </view>

      <view class="student-arrow">›</view>
    </view>

    <!-- 空状态 -->
    <view class="empty" wx:if="{{students.length === 0}}">
      <view class="empty-icon">👨‍🎓</view>
      <view class="empty-text">暂无学生数据</view>
    </view>
  </view>

</view>
