.appointment-container {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding-bottom: 120rpx;
}

/* ===== 日历卡片 ===== */
.calendar-card {
  margin: 20rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
}

/* 月份切换头 */
.month-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 20rpx 20rpx;
}

.month-arrow {
  font-size: 48rpx;
  color: #07c160;
  padding: 0 20rpx;
  font-weight: 300;
}

.month-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.month-subtitle {
  text-align: center;
  font-size: 24rpx;
  color: #07c160;
  margin-bottom: 16rpx;
}

/* 星期头 */
.weekday-row {
  display: flex;
  padding: 0 4rpx 16rpx;
}

.weekday {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #999;
  font-weight: 600;
}

/* 日期网格 */
.day-grid {
  display: flex;
  flex-wrap: wrap;
}

.day-cell {
  width: calc(100% / 7);
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  border-radius: 12rpx;
  transition: background 0.15s;
}

.day-num {
  font-size: 28rpx;
  color: #333;
}

/* 有预约的小圆点 */
.day-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background-color: #07c160;
  margin-top: 6rpx;
}

/* 非当月日期 */
.day-cell.other-month .day-num {
  color: #ddd;
}

/* 今天 */
.day-cell.today {
  background-color: rgba(7, 193, 96, 0.08);
}

.day-cell.today .day-num {
  color: #07c160;
  font-weight: bold;
}

/* 选中态 */
.day-cell.selected {
  background-color: #07c160;
}

.day-cell.selected .day-num {
  color: #fff;
  font-weight: bold;
}

.day-cell.selected .day-dot {
  background-color: #fff;
}

/* ===== 详情面板（弹出层） ===== */
.detail-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  /* 增大到 72vh，确保有足够的可视空间 */
  height: 72vh;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  z-index: 200;
  box-shadow: 0 -8rpx 40rpx rgba(0,0,0,0.12);
}

.detail-panel.show {
  transform: translateY(0);
}

/* 拖拽指示条 */
.panel-drag-bar {
  display: flex;
  justify-content: center;
  padding: 16rpx 0 8rpx;
}

.panel-drag-bar-inner {
  width: 60rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #ddd;
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 30rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}

.panel-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.panel-close {
  font-size: 36rpx;
  color: #999;
  padding: 8rpx 16rpx;
  line-height: 1;
}

/* 预约列表 — 可滚动区域 */
.appointment-list {
  flex: 1;
  overflow-y: auto;
  padding: 20rpx 30rpx;
  -webkit-overflow-scrolling: touch;
}

.appointment-card {
  background: #f9fafb;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.appointment-card:last-child {
  margin-bottom: 40rpx;
}

/* 空状态 — 在面板内居中 */
.appointment-list .empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 120rpx;
}

.appt-top {
  display: flex;
  align-items: center;
}

.appt-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: #e8e8e8;
}

.appt-info {
  flex: 1;
}

.appt-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 4rpx;
}

.appt-time {
  font-size: 24rpx;
  color: #888;
}

.appt-status {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.appt-status.pending {
  background: #fff7e6;
  color: #fa8c16;
}

.appt-status.confirmed {
  background: #e6f7ff;
  color: #1890ff;
}

.appt-status.cancelled {
  background: #f5f5f5;
  color: #999;
}

.appt-status.completed {
  background: #f6ffed;
  color: #52c41a;
}

.appt-reason {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
}

/* 操作按钮 */
.appt-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.action-btn {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 24rpx;
  font-size: 24rpx;
  border: 2rpx solid currentColor;
}

.action-btn.confirm {
  color: #07c160;
}

.action-btn.complete {
  color: #1890ff;
}

.action-btn.cancel {
  color: #999;
}

/* ===== 遮罩层 ===== */
.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.35);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
  z-index: 150;
}

.overlay.show {
  opacity: 1;
  pointer-events: auto;
}

/* ===== 空状态 ===== */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
