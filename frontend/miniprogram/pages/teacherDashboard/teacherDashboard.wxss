.dashboard {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f7fa;
}

/* ===== 学生个人信息卡片 ===== */
.student-profile {
  display: flex;
  align-items: center;
  margin: 20rpx;
  padding: 30rpx;
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(24, 144, 255, 0.25);
  flex-shrink: 0;
}

.profile-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.4);
  margin-right: 24rpx;
  background: rgba(255,255,255,0.3);
  flex-shrink: 0;
}

.profile-info {
  flex: 1;
}

.profile-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 8rpx;
}

.profile-meta {
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
}

.profile-meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.profile-tag {
  font-size: 22rpx;
  color: rgba(255,255,255,0.9);
  background: rgba(255,255,255,0.2);
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
}

/* ===== 老师备注区域 ===== */
.notes-section {
  background: #fff;
  margin: 0 20rpx 16rpx;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  flex-shrink: 0;
}

.notes-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.notes-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.notes-action {
  font-size: 24rpx;
  color: #1890ff;
  padding: 6rpx 16rpx;
  border: 2rpx solid #1890ff;
  border-radius: 20rpx;
}

.notes-display {
  min-height: 60rpx;
}

.notes-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.notes-edit {
  margin-top: 12rpx;
}

.notes-textarea {
  width: 100%;
  min-height: 120rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 26rpx;
  box-sizing: border-box;
  margin-bottom: 16rpx;
}

.notes-btns {
  display: flex;
  gap: 16rpx;
}

.btn-cancel,
.btn-save {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  text-align: center;
  padding: 0;
}

.btn-cancel {
  background: #f5f5f5;
  color: #666;
  border: none;
}

.btn-save {
  background: #1890ff;
  color: #fff;
  border: none;
}

/* ===== 标题 ===== */
.header {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  padding: 30rpx 0;
  flex-shrink: 0;
}

/* ===== 可滚动记录区域 ===== */
.record-scroll {
  flex: 1;
  padding: 0 0 20rpx;
}

.record-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin: 0 20rpx 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.record-card:active {
  background: #f5f5f5;
  transform: scale(0.98);
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 12rpx;
  margin-bottom: 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.student-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #1890ff;
}

.time {
  font-size: 22rpx;
  color: #999;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.card-mid {
  margin-bottom: 12rpx;
}

.scale-name {
  font-size: 24rpx;
  color: #555;
}

.card-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.result-row {
  flex: 1;
  overflow: hidden;
}

.result-text {
  font-size: 24rpx;
  color: #666;
  white-space: nowrap;
}

.rating {
  display: inline;
  font-size: 24rpx;
  font-weight: bold;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.arrow {
  font-size: 36rpx;
  color: #ccc;
  margin-left: auto;
}

/* 警示颜色 */
.safe {
  color: #07c160;
  background: rgba(7, 193, 96, 0.1);
}

.danger {
  color: #ff4d4f;
  background: rgba(255, 77, 79, 0.1);
}

/* ===== 空状态 ===== */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
