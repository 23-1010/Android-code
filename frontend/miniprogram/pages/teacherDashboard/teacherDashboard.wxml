<view class="dashboard">

  <!-- 学生个人信息卡片（从「我的学生」点进来时显示） -->
  <view class="student-profile" wx:if="{{studentId}}">
    <image class="profile-avatar" src="{{studentAvatar || 'https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=200'}}" mode="aspectFill"></image>
    <view class="profile-info">
      <view class="profile-name">{{studentProfile.realName || studentName || '学生详情'}}</view>
      <view class="profile-meta-row">
        <text class="profile-tag" wx:if="{{studentProfile.gender}}">{{studentProfile.gender}}</text>
        <text class="profile-tag" wx:if="{{studentProfile.age > 0}}">{{studentProfile.age}} 岁</text>
        <text class="profile-tag" wx:if="{{!studentProfile.age || studentProfile.age === 0}}">年龄未知</text>
        <text class="profile-meta">{{records.length > 0 ? '共 ' + records.length + ' 条记录' : '暂无测评记录'}}</text>
      </view>
    </view>
  </view>

  <!-- 标题 -->
  <view class="header" wx:if="{{!studentId}}">📋 学生测评数据大屏</view>

  <!-- 老师备注区域（从学生列表点进来时显示） -->
  <view class="notes-section" wx:if="{{studentId}}">
    <view class="notes-header">
      <view class="notes-title">📝 老师备注</view>
      <view class="notes-action" wx:if="{{!isEditingNotes}}" bindtap="startEditNotes">编辑</view>
    </view>

    <!-- 展示模式 -->
    <view class="notes-display" wx:if="{{!isEditingNotes}}">
      <text class="notes-text">{{teacherNotes || '暂无备注，点击右侧"编辑"添加'}}</text>
    </view>

    <!-- 编辑模式 -->
    <view class="notes-edit" wx:if="{{isEditingNotes}}">
      <textarea class="notes-textarea" value="{{editingNotes}}" bindinput="onNotesInput" placeholder="在此输入对该学生的备注..." maxlength="500" auto-height="{{true}}"/>
      <view class="notes-btns">
        <button class="btn-cancel" bindtap="cancelEditNotes">取消</button>
        <button class="btn-save" bindtap="saveNotes">保存</button>
      </view>
    </view>
  </view>

  <!-- 测评记录列表 -->
  <scroll-view class="record-scroll" scroll-y="true" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view
      class="record-card"
      wx:for="{{records}}"
      wx:key="id"
      bindtap="onRecordTap"
      data-record-id="{{item.id}}"
    >
      <view class="card-top">
        <text class="student-name" wx:if="{{!studentId}}">👤 {{item.nickname}}</text>
        <text class="student-name" wx:else>{{item.scale_name}}</text>
        <text class="time">{{item.create_time}}</text>
      </view>

      <view class="card-mid">
        <text class="scale-name" wx:if="{{!studentId}}">量表：{{item.scale_name}}</text>
        <text class="scale-name" wx:else>类型：{{item.scale_type}}</text>
      </view>

      <view class="card-bottom">
        <view class="result-row">
          <text class="result-text">总分：{{item.total_score}}　系统判定：<text class="rating {{item.result_rating == '重度抑郁' || item.result_rating == '阳性' ? 'danger' : 'safe'}}">{{item.result_rating}}</text></text>
        </view>
        <text class="arrow">›</text>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty" wx:if="{{records.length === 0}}">
      <view class="empty-icon">📋</view>
      <view class="empty-text" wx:if="{{studentId}}">{{studentProfile.realName || studentName}} 暂无测评记录</view>
      <view class="empty-text" wx:else>暂无测评记录</view>
    </view>
  </scroll-view>

</view>
