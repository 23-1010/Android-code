.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background: linear-gradient(135deg, #fce4ec 0%, #f8bbd0 50%, #fce4ec 100%);
  display: flex;
  align-items: center;
  justify-content: space-around;
  border-top: 1rpx solid rgba(0,0,0,0.06);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.04);
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 100%;
  position: relative;
}

.tab-text {
  font-size: 30rpx;
  color: #999;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.tab-item.active .tab-text {
  color: #e91e63;
  font-weight: 700;
}

.tab-dot {
  position: absolute;
  top: 18rpx;
  right: 50%;
  margin-right: -28rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #e91e63;
}
