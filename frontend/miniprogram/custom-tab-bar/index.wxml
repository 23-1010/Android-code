<view class="tab-bar">
  <view
    class="tab-item {{selected === index ? 'active' : ''}}"
    wx:for="{{list}}"
    wx:key="pagePath"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <view class="tab-text">{{item.text}}</view>
    <view class="tab-dot" wx:if="{{item.dot}}"></view>
  </view>
</view>
